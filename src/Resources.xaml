 <SolidColorBrush x:Key="Bg" Color="#20242C"/><SolidColorBrush x:Key="Side" Color="#252A34"/><SolidColorBrush x:Key="Surface" Color="#2C323D"/><SolidColorBrush x:Key="Line" Color="#424A57"/><SolidColorBrush x:Key="Text" Color="#F0F3F9"/><SolidColorBrush x:Key="Muted" Color="#AEB9CA"/><SolidColorBrush x:Key="SelectedText" Color="#F0F3F9"/><SolidColorBrush x:Key="Accent" Color="#2786F5"/>
