<Window x:Class="Shiguang.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Shiguang" Title="时光相册" Width="1536" Height="1024" MinWidth="1150" MinHeight="750" FontSize="14" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <Style x:Key="RowContainer" TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="MediaTile" DataType="{x:Type l:GalleryItem}">
   <CheckBox Style="{StaticResource TileCheck}" VerticalAlignment="Top" Width="{Binding Width}" IsChecked="{Binding Photo.Selected, Mode=TwoWay}" Margin="0,0,6,6" MouseDoubleClick="Tile_DoubleClick" ToolTip="{Binding Photo.Path}" AutomationProperties.Name="{Binding Photo.Name}"><StackPanel>
    <Border Background="{DynamicResource Placeholder}" CornerRadius="5" Height="{Binding Height}" ClipToBounds="True"><Grid><l:FluentIcon Kind="{Binding Photo.IconKind}" Width="35" Height="35" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><l:ThumbnailImage File="{Binding Photo.ThumbKey}" DecodeWidth="{Binding Width}" Stretch="Uniform"/><Border Background="{DynamicResource MediaScrim}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5" Margin="6" Visibility="{Binding Photo.VideoVisibility}"><l:FluentIcon Kind="play" Foreground="White" Width="18" Height="18"/></Border><Border Background="{DynamicResource MediaScrim}" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="6,2" Margin="6" Visibility="{Binding Photo.VideoVisibility}"><TextBlock Text="{Binding Photo.DurationLabel}" Foreground="White" FontSize="13"/></Border><l:FluentIcon Kind="heart" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Foreground="{DynamicResource Favorite}" Visibility="{Binding Photo.FavoriteVisibility}"/></Grid></Border>
    <DockPanel Margin="2,5,2,0"><l:FluentIcon Kind="{Binding Photo.IconKind}" Width="16" Height="16" Margin="0,1,6,0" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Photo.Name}" Foreground="{DynamicResource Text}" FontSize="13" TextTrimming="CharacterEllipsis"/></DockPanel>
   </StackPanel></CheckBox>
  </DataTemplate>
 </Window.Resources>
 <Grid Background="{DynamicResource Bg}" x:Name="RootGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><Grid Margin="14,18,14,15"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"><Image Source="Assets/Shiguang.ico" Width="32" Height="32" VerticalAlignment="Top"/><StackPanel Margin="11,0,0,0"><TextBlock Text="时光相册" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="本地媒体库" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></StackPanel>
   <ScrollViewer x:Name="SideNavigation" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel l:NavigationKeys.Enabled="True">
    <Button x:Name="TimelineNav" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="timeline" AutomationProperties.Name="时间线"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="calendar"/><TextBlock Text="时间线" Margin="10,0,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="albums" AutomationProperties.Name="相册"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="folder"/><TextBlock Text="相册" Margin="10,0,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="favorites" AutomationProperties.Name="收藏"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="heart"/><TextBlock Text="收藏" Margin="10,0,0,0"/></StackPanel></Button>
    <Button x:Name="DuplicateButton" Style="{StaticResource NavButton}" Click="Duplicates_Click" ToolTip="快速查找重复照片" AutomationProperties.Name="重复照片" IsEnabled="{Binding CanFindDuplicates}"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="copy"/><TextBlock Text="重复照片" Margin="10,0,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Trash_Click" AutomationProperties.Name="回收站"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="delete"/><TextBlock Text="回收站" Margin="10,0,0,0"/></StackPanel></Button>    <Border Height="1" Background="{DynamicResource Line}" Margin="9,12,9,12"/><TextBlock Text="媒体类型" FontSize="12" Foreground="{DynamicResource Muted}" Margin="14,0,0,8"/>
    <Button Style="{StaticResource NavButton}" Click="Type_Click" Tag="image" AutomationProperties.Name="照片"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="image"/><TextBlock Text="照片" Margin="10,0,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Type_Click" Tag="video" AutomationProperties.Name="视频"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="video"/><TextBlock Text="视频" Margin="10,0,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Type_Click" Tag="panorama" AutomationProperties.Name="全景图"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="image_multiple"/><TextBlock Text="全景图" Margin="10,0,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Type_Click" Tag="screenshot" AutomationProperties.Name="截图"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="screenshot"/><TextBlock Text="截图" Margin="10,0,0,0"/></StackPanel></Button>
   </StackPanel>
   <DockPanel Margin="14,17,0,7"><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="新建相册" AutomationProperties.Name="新建相册" Margin="0" Click="NewAlbum_Click"><l:FluentIcon Kind="folder_add" Width="18" Height="18"/></Button><TextBlock Text="我的相册" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
   <ListBox x:Name="AlbumList" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding Albums}" SelectionChanged="Album_SelectionChanged" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="8,0,0,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DockPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Selected}"/><Setter Property="Foreground" Value="{DynamicResource SelectedText}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
   </StackPanel></ScrollViewer><StackPanel Grid.Row="2"><Button Style="{StaticResource NavButton}" Click="More_Click" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="settings" Width="20" Height="20"/><TextBlock Text="设置" Margin="12,0,0,0"/></StackPanel></Button></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="{Binding FilterRowHeight}"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="HeaderGrid" Margin="16,10,16,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Heading}" MaxWidth="190" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding Heading}" FontSize="{x:Static l:UiMetrics.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Border x:Name="ModeSwitch" Grid.ColumnSpan="3" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center" PreviewKeyDown="ModeSwitch_KeyDown" KeyboardNavigation.TabNavigation="Once" Visibility="{Binding ShowTimelineSwitch, Converter={StaticResource BoolVis}}">
      <StackPanel Orientation="Horizontal"><l:SegmentChoice x:Name="YearMode" Style="{StaticResource SegmentButton}" Content="年" Width="40" Click="Mode_Click" Tag="years" AutomationProperties.Name="按年浏览"/><l:SegmentChoice x:Name="MonthMode" Style="{StaticResource SegmentButton}" Content="月" Width="40" Click="Mode_Click" Tag="months" AutomationProperties.Name="按月浏览"/><l:SegmentChoice x:Name="DayMode" Style="{StaticResource SegmentButton}" Content="日" Width="40" Click="Mode_Click" Tag="days" AutomationProperties.Name="按日浏览"/></StackPanel>
     </Border>
     <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SearchColumn" Width="180"/><ColumnDefinition x:Name="ActionColumn" Width="140"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,8,0"><TextBox x:Name="SearchBox" FontSize="13" Padding="30,4,8,4" Height="32" MinHeight="32" TextChanged="Search_Changed" PreviewKeyDown="Search_KeyDown" AutomationProperties.Name="搜索文件名或标签" ToolTip="搜索文件名或标签（Ctrl+F）"/><l:FluentIcon Kind="search" Width="16" Height="16" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/><TextBlock Text="搜索" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <ToolBar x:Name="ActionToolbar" Grid.Column="1" Width="140" Style="{StaticResource CompactToolBar}" AutomationProperties.Name="媒体库工具">
       <Button x:Name="DetailsButton" Style="{StaticResource ToolbarActionButton}" Visibility="{Binding CanShowDetails, Converter={StaticResource BoolVis}}" Click="Details_Click" ToolTip="显示详情" AutomationProperties.Name="详情"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="info" Width="18" Height="18"/><TextBlock Text="详情" Style="{StaticResource ToolbarCaption}"/></StackPanel></Button>
       <Button Style="{StaticResource ToolbarActionButton}" Click="Import_Click" AutomationProperties.Name="添加来源目录" ToolTip="添加来源目录" IsEnabled="{Binding CanScan}"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="folder_add" Width="18" Height="18"/><TextBlock Text="添加来源目录" Style="{StaticResource ToolbarCaption}"/></StackPanel></Button>
       <Button Style="{StaticResource ToolbarActionButton}" Click="Rescan_Click" AutomationProperties.Name="重新扫描" ToolTip="重新扫描来源目录" IsEnabled="{Binding CanScan}"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="arrow_clockwise" Width="18" Height="18"/><TextBlock Text="重新扫描" Style="{StaticResource ToolbarCaption}"/></StackPanel></Button>
       <Button Style="{StaticResource ToolbarActionButton}" ToolBar.OverflowMode="Always" Click="NewAlbum_Click" Visibility="{Binding IsAlbumOverview, Converter={StaticResource BoolVis}}" AutomationProperties.Name="新建相册" ToolTip="新建相册"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="folder_add" Width="18" Height="18"/><TextBlock Text="新建相册" Style="{StaticResource ToolbarCaption}"/></StackPanel></Button>
       <Button Style="{StaticResource ToolbarActionButton}" ToolBar.OverflowMode="Always" Click="More_Click" AutomationProperties.Name="打开设置" ToolTip="设置"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="settings" Width="18" Height="18"/><TextBlock Text="设置" Style="{StaticResource ToolbarCaption}"/></StackPanel></Button>
       <Button Style="{StaticResource ToolbarActionButton}" ToolBar.OverflowMode="Always" Click="Exit_Click" AutomationProperties.Name="退出程序" ToolTip="退出程序"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="dismiss" Width="18" Height="18"/><TextBlock Text="退出程序" Style="{StaticResource ToolbarCaption}"/></StackPanel></Button>
      </ToolBar>
     </Grid>
    </Grid>    <StackPanel Visibility="Collapsed"><ComboBox x:Name="YearBox" SelectionChanged="Year_Changed"/><ComboBox x:Name="MonthBox" SelectionChanged="Month_Changed"/><ComboBox x:Name="DayBox" SelectionChanged="Day_Changed"/><ComboBox x:Name="KindBox" SelectionChanged="Kind_Changed"/></StackPanel>    <Grid Grid.Row="2" Margin="20,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="{Binding DetailWidth}"/><ColumnDefinition Width="{Binding RailWidth}"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="4,0,4,4"><TextBlock Text="{Binding Summary}" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/><Button Content="{Binding DateBreadcrumb}" Click="ClearDate_Click" ToolTip="返回全部时间" FontSize="13" Padding="2,0" MinHeight="24" HorizontalAlignment="Left"/></DockPanel>
     <ListBox x:Name="Gallery" Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RowContainer}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.ScrollChanged="Gallery_ScrollChanged" Padding="0,0,8,16" Visibility="{Binding ShowGallery, Converter={StaticResource BoolVis}}"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type l:GalleryRow}"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text}" Visibility="{Binding LabelVisibility}" FontSize="18" FontWeight="SemiBold" Margin="7,16,0,14"/><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource MediaTile}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <ScrollViewer x:Name="BucketScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowBuckets, Converter={StaticResource BoolVis}}"><ItemsControl ItemsSource="{Binding Buckets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type l:TimeBucket}"><Button Width="{Binding BucketWidth, RelativeSource={RelativeSource AncestorType=Window}}" Margin="5,8,10,14" Padding="0" Background="Transparent" BorderThickness="0" Click="Bucket_Click"><StackPanel><Border Height="145" Background="{DynamicResource Placeholder}" CornerRadius="8" ClipToBounds="True"><l:ThumbnailImage File="{Binding Cover}" Stretch="UniformToFill"/></Border><DockPanel Margin="2,12,2,0"><TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource Muted}" FontSize="13" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="{Binding Label}" FontSize="20" FontWeight="SemiBold"/></DockPanel></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"><l:FluentIcon Kind="image_multiple" Width="58" Height="58" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="{Binding EmptyHeading}" FontSize="23" HorizontalAlignment="Center" Margin="0,20,0,12"/><TextBlock Text="{Binding EmptyDescription}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="25"/><Button Content="添加照片或视频目录" Style="{StaticResource PrimaryButton}" Click="Import_Click" IsEnabled="{Binding CanScan}" Visibility="{Binding ShowEmptyImport, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center" Margin="0,22,0,0"/><Button Content="新建相册" Style="{StaticResource PrimaryButton}" Click="NewAlbum_Click" Visibility="{Binding ShowEmptyAlbumAction, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center" Margin="0,22,0,0"/><Button Content="去选择照片或视频" Tag="timeline" Style="{StaticResource PrimaryButton}" Click="Nav_Click" Visibility="{Binding ShowEmptyTimelineAction, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center" Margin="0,22,0,0"/></StackPanel>
    </Grid>
    <Border Grid.Column="1" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Margin="12,0,0,0" Visibility="{Binding ShowDetails, Converter={StaticResource BoolVis}}">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,12">
      <TextBlock Text="项目详情" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <l:ThumbnailImage File="{Binding FocusedPhoto.ThumbKey}" Height="175" Stretch="Uniform"/>
      <TextBlock Text="{Binding FocusedPhoto.Name}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,12"/>
      <TextBlock Text="{Binding FocusedPhoto.TypeLabel}" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding FocusedPhoto.CaptureLabel}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding FocusedPhoto.Details}" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding FocusedPhoto.Error}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" FontSize="13"/>
      <TextBlock Text="所属相册" Foreground="{DynamicResource Muted}" Margin="0,22,0,8"/>
      <TextBlock Text="{Binding MembershipText}" TextWrapping="Wrap"/>
      <Button Content="打开预览" Click="OpenFocused_Click" Margin="0,24,0,10"/>
      <Button Content="复制原文件路径" Click="CopyPath_Click" Margin="0,0,0,10"/>
      <TextBlock Text="{Binding FocusedPhoto.Path}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}"/>
     </StackPanel></ScrollViewer>
    </Border>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,30,0,0"><ItemsControl ItemsSource="{Binding RailYears}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Tag="{Binding}" Padding="4,9" Margin="0,2" Background="Transparent" BorderThickness="0" FontSize="14" Click="RailYear_Click"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid>
   <Border Grid.Row="3" Visibility="{Binding ShowFooter, Converter={StaticResource BoolVis}}" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,9">
    <StackPanel>
     <DockPanel LastChildFill="False" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}" Margin="0,0,0,10">
      <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="0,0,22,0"/>
      <Button Click="AddToAlbum_Click" AutomationProperties.Name="加入相册" IsEnabled="{Binding CanMutate}"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="folder_add"/><TextBlock Text="加入相册" Margin="8,0,0,0"/></StackPanel></Button>
      <Button Click="Favorite_Click" AutomationProperties.Name="收藏" IsEnabled="{Binding CanMutate}"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="heart"/><TextBlock Text="收藏" Margin="8,0,0,0"/></StackPanel></Button>
      <Button Click="DeleteSelection_Click" AutomationProperties.Name="移入回收站" IsEnabled="{Binding CanScan}"><StackPanel Orientation="Horizontal"><l:FluentIcon Kind="delete" Width="18" Height="18"/><TextBlock Text="移入回收站" Margin="8,0,0,0"/></StackPanel></Button><Button Content="移出相册" Click="RemoveFromAlbum_Click" Visibility="{Binding InAlbum, Converter={StaticResource BoolVis}}" IsEnabled="{Binding CanMutate}"/>
      <Button Click="SelectionMore_Click" AutomationProperties.Name="更多操作" Style="{StaticResource IconButton}" ToolTip="分类、标签与索引日期"><l:FluentIcon Kind="more_horizontal"/></Button>
     </DockPanel>
     <DockPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button Content="{Binding PauseText}" Click="Pause_Click" Padding="10,6" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}"/>
       <Button Content="停止" Click="Stop_Click" Padding="10,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel>
     <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
    </StackPanel>
   </Border>
  </Grid>
  <l:NoticeBar x:Name="Notification" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,0,20,18" Panel.ZIndex="10"/>
 </Grid>
</Window>
